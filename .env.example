# Bolonha App — variáveis de ambiente (exemplo SEM credenciais reais).
# Copie para .env.local e preencha. Nunca versione .env.local.

# ── Públicas (vão para o navegador; a segurança real vem do RLS) ───────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Buscadores só enxergam o site com "true". Deixe vazio até o lançamento.
NEXT_PUBLIC_ALLOW_INDEXING=
NEXT_PUBLIC_SUPABASE_URL=
# Chave pública do projeto Supabase (anon key OU publishable key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Somente servidor (NUNCA prefixar com NEXT_PUBLIC_) ──────────────────────
# Ignora RLS. Só pode ser importada de src/lib/supabase/admin.ts (server-only).
SUPABASE_SERVICE_ROLE_KEY=

# Fuso do negócio. Fonte única: não altere sem revisar o motor de agenda.
APP_TIMEZONE=America/Sao_Paulo
